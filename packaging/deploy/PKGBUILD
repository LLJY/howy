prepare() {
  cd "${srcdir}/${pkgname}"

  local actual_commit
  actual_commit=$(git rev-parse HEAD)
  if [[ "${actual_commit}" != "${_commit}" ]]; then
    printf 'source revision mismatch: expected %s, got %s\n' \
      "${_commit}" "${actual_commit}" >&2
    return 1
  fi

  patch -Np1 -i "${srcdir}/pam-silent-mode0.patch"
  patch -Np1 -i "${srcdir}/provision-presence.patch"
  patch -Np1 -i "${srcdir}/failed-supervisor-recovery.patch"
  patch -Np1 -i "${srcdir}/real-prefix-recovery.patch"
  patch -Np1 -i "${srcdir}/systemd-socket-running.patch"

  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_TARGET_DIR="${srcdir}/cargo-target"
  export CARGO_BUILD_RUSTFLAGS='-C target-cpu=x86-64'
  export CARGO_INCREMENTAL=0
  export ORT_LIB_PATH=/usr/lib
  export ORT_PREFER_DYNAMIC_LINK=1

  cargo fetch --locked
}

build() {
  cd "${srcdir}/${pkgname}"

  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_TARGET_DIR="${srcdir}/cargo-target"
  export CARGO_BUILD_RUSTFLAGS='-C target-cpu=x86-64'
  export CARGO_INCREMENTAL=0
  export ORT_LIB_PATH=/usr/lib
  export ORT_PREFER_DYNAMIC_LINK=1

  cargo build --frozen --release \
    -p howy-daemon \
    --bin howyd
  cargo build --frozen --release \
    -p howy-cli \
    --bin howy
  cargo build --frozen --release \
    -p howy-pam \
    --lib
}

check() {
  cd "${srcdir}/${pkgname}"

  export CARGO_HOME="${srcdir}/cargo-home"
  export CARGO_TARGET_DIR="${srcdir}/cargo-target"
  export CARGO_BUILD_RUSTFLAGS='-C target-cpu=x86-64'
  export CARGO_INCREMENTAL=0
  export ORT_LIB_PATH=/usr/lib
  export ORT_PREFER_DYNAMIC_LINK=1

  cargo test --frozen -p howy-common -p howy-cli
}

package() {
  local source_root="${srcdir}/${pkgname}"
  local target="${srcdir}/cargo-target/release"

  install -Dm755 "${target}/howyd" "${pkgdir}/usr/bin/howyd"
  install -Dm755 "${target}/howy" "${pkgdir}/usr/bin/howy"
  install -Dm644 "${target}/libpam_howy.so" \
    "${pkgdir}/usr/lib/security/pam_howy.so"
  ln -s pam_howy.so "${pkgdir}/usr/lib/security/pam_howdy.so"
  install -dm700 "${pkgdir}/etc/howy"
  install -Dm600 "${srcdir}/config.toml" \
    "${pkgdir}/etc/howy/config.toml"
  install -Dm644 "${source_root}/systemd/howy.service" \
    "${pkgdir}/usr/lib/systemd/system/howy.service"
  install -Dm644 "${source_root}/systemd/howy.socket" \
    "${pkgdir}/usr/lib/systemd/system/howy.socket"
  install -Dm600 "${srcdir}/package-capability.marker" \
    "${pkgdir}/var/lib/howy-package-bootstrap.complete"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "${source_root}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
